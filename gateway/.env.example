# Copy to .env. Every setting is in src/voicegw/config.py (prefix VG_).
VG_SECRET_KEY=            # random string; signs browser session tokens
VG_SONIOX_API_KEY=
VG_LLM_API_KEY=           # OpenAI, or any OpenAI-compatible provider with VG_LLM_BASE_URL
# VG_LLM_BASE_URL=https://openrouter.ai/api/v1
VG_LLM_MODEL=gpt-5.4-mini
VG_TONE_MODEL=gpt-4.1-mini
VG_WORKER_URL=http://127.0.0.1:8100
# VG_WORKER_TOKEN=        # must match VG_WORKER_TOKEN on the worker
# VG_STT_PROVIDERS=["soniox","openai"]   # order of preference; failing ones are skipped for a while
# VG_OPENAI_STT_MODEL=gpt-live-transcribe
# Accounts, API keys, voices and usage from the Dhvni dashboard's Supabase project (Project
# Settings > API keys > secret key). Leave both unset to use the gateway's own database.
# VG_SUPABASE_URL=https://buvqnadnymjgrwqfnmwu.supabase.co
# VG_SUPABASE_SECRET_KEY=sb_secret_...
# VG_REQUIRE_CREDIT=false   # true: 402 once an account's prepaid balance is used up
